# NOTE: Use CONSOLE for vboot debugging
FLASH 8M {
	SI_ALL 2M {
		SI_DESC 0x1000
		SI_ME 0x1ff000
	}
	SI_BIOS 6M {
		EC 0x20000
		RW_SECTION_A 0x2ca000 {
			VBLOCK_A 0x2000
			FW_MAIN_A(CBFS) 0x2c7fc0
			RW_FWID_A 0x40
		}
		RW_MISC 0x6a000 {
			UNIFIED_MRC_CACHE(PRESERVE) 0x20000 {
				RECOVERY_MRC_CACHE 0x10000
				RW_MRC_CACHE 0x10000
			}
			RW_SHARED 0x4000 {
				SHARED_DATA 0x2000
				VBLOCK_DEV 0x2000
			}
			RW_NVRAM(PRESERVE) 0x2000
			# SMMSTORE requires 64k alignment
			SMMSTORE(PRESERVE) 0x40000
			RW_ELOG(PRESERVE) 0x4000
			CONSOLE 0x20000
		}
		WP_RO 0x28a000 {
			FMAP 0x800
			RO_FRID 0x40
			RO_FRID_PAD 0x7c0
			GBB 0x3000
			COREBOOT(CBFS) 0x286000
		}
	}
}
